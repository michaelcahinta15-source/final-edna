# NextAuth Configuration
AUTH_SECRET=your-super-secret-key-here-generate-a-random-string
AUTH_MICROSOFT_ENTRA_ID_ID=your-microsoft-entra-id-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-microsoft-entra-id-client-secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common # or your specific tenant ID
AUTH_URL=http://localhost:3000

# Optional: independent admin sign-in (set both values to enable it)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: Gemini API Key for AI-powered summarization
GEMINI_API_KEY=your-gemini-api-key-here

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000